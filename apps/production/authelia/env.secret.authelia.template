# !! DO NOT TYPE A REAL VALUE INTO THIS FILE. It is committed and this repository is PUBLIC.
# !! Copy it first; edit only the copy. The copy is gitignored (`.env*`), the `.encrypted`
# !! output is what gets committed.
#
# TEMPLATE. From the repo root:
#
#   cp apps/production/authelia/env.secret.authelia.template \
#      apps/production/authelia/.env.secret.authelia
#   $EDITOR apps/production/authelia/.env.secret.authelia
#   ./scripts/encrypt-env-files.sh apps/production/authelia/.env.secret.authelia
#
# Run that last command YOURSELF rather than asking the agent to. The agent must never create,
# read or write the real path: on 2026-08-29 two credentials were burned because the real file
# was in the agent's read-set and the harness reported the change including the secret line.
#
# The script is a wrapper around:
#   sops encrypt --age age1nur86m07v4f94xpc8ugg0cmum9fpyp3hcha2cya6x09uphu4zg5szrtzgt \
#     --input-type dotenv --output-type dotenv <file> > <file>.encrypted
#
# ---------------------------------------------------------------------------------------
# THIS FILE IS A TEMPLATE, NOT A BACKUP
# ---------------------------------------------------------------------------------------
#
# If .env.secret.authelia already exists with real values, DO NOT copy over it. Rotating
# storage_encryption_key in particular is not a matter of writing a new value: it re-keys the
# database and needs `authelia storage encryption change-key` against the running instance.
# Overwrite it here and the existing TOTP registrations become undecryptable.
#
# All three are 32 random bytes hex-encoded:  openssl rand -hex 32
# The deployment maps each to the matching AUTHELIA_* variable; see authelia-deployment.yaml.

# identity_validation.reset_password.jwt_secret
jwt_secret=<REPLACE-ME-openssl-rand-hex-32>

# session.secret. Changing it invalidates every live session, which is harmless.
session_secret=<REPLACE-ME-openssl-rand-hex-32>

# storage.encryption_key. See the warning above before changing this one.
storage_encryption_key=<REPLACE-ME-openssl-rand-hex-32>
