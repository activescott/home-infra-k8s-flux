# !! DO NOT PUT A REAL HASH IN THIS FILE. It is committed and this repository is PUBLIC.
# !! Copy it first; edit only the copy. The copy is gitignored (`*.secret`), the `.encrypted`
# !! output is what gets committed.
#
# TEMPLATE. From this directory:
# scripts/encrypt-env-files.sh handles .env files; this file needs binary format (see below).
#
#   cd apps/production/authelia
#   cp authelia-users.secret.template authelia-users.secret
#   $EDITOR authelia-users.secret
#   SOPS_AGE_KEY_FILE=../../../home-infra-private.agekey sops encrypt \
#     --age age1nur86m07v4f94xpc8ugg0cmum9fpyp3hcha2cya6x09uphu4zg5szrtzgt \
#     --input-type binary --output-type binary \
#     authelia-users.secret > authelia-users.secret.encrypted
#   rm authelia-users.secret
#
# Run that YOURSELF rather than asking the agent to; same reasoning as
# env.secret.authelia.template.
#
# binary, not yaml, deliberately: SOPS leaves YAML keys in plaintext, so a yaml-encrypted copy
# would publish the usernames and the structure. binary encrypts the whole file. The
# secretGenerator key must stay `users` (no extension) to match -- kustomize-controller derives
# the SOPS format from the generator KEY, not the filename.
#
# Generate the hash with the same image the deployment runs, and quote the password so the shell
# leaves it alone:
#
#   docker run --rm authelia/authelia:4.39.26 \
#     authelia crypto hash generate argon2 --password 'YOUR_PASSWORD'
#
# Authelia's file backend does not enforce complexity. Use at least 16 characters with mixed
# case, digits, and symbols.
# Adding or changing a user means re-encrypting this file and restarting the pod: the Secret is
# generated with disableNameSuffixHash, so Flux has no spec change to roll on.
#
#   kubectl --context nas rollout restart -n authelia deploy/authelia
users:
  scott:
    displayname: Scott Willeke
    email: scott@willeke.com
    password: <REPLACE-ME-argon2-hash-starting-$argon2id$>
    groups:
      - admins
