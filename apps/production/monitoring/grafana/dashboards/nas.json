            "uid": "PBFA97CFB590B2093"
          },
          "expr": "time() - max by (pool, volume) (zfs_snapshot_latest_time_seconds{pool=\"backupspool\",volume=~\"/replication/.+\"})",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "pool": 0,
