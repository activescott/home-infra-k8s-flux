    {
      "id": 6,
      "type": "stat",
      "title": "B2 backup: last run",
      "description": "Last run of the weekly B2 sync. Duration comes from the job wrapper; the file, byte, delete and error counts come from nas1_backup_b2_*, which the host does not write yet.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "color": {
            "mode": "fixed",
            "fixedColor": "transparent"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "C"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "E"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "max(nas1_job_duration_seconds{job=\"backup-b2\"})",
          "refId": "A",
          "legendFormat": "Duration"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "max(nas1_backup_b2_transferred_files)",
          "refId": "B",
          "legendFormat": "Files uploaded"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "max(nas1_backup_b2_transferred_bytes)",
          "refId": "C",
          "legendFormat": "Bytes uploaded"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "max(nas1_backup_b2_deleted_files)",
          "refId": "D",
          "legendFormat": "Files deleted"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "max(nas1_backup_b2_errors)",
          "refId": "E",
          "legendFormat": "Errors"
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Newest snapshot age, thedatapool",
      "description": "time() - zfs_snapshot_latest_time_seconds for the seven datasets sanoid snapshots daily. Red over 26 hours, where NasSnapshotStale fires.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 93600
              }
            ]
          },
          "custom": {
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Age"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Age",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "time() - max by (pool, volume) (zfs_snapshot_latest_time_seconds{pool=\"thedatapool\",volume=~\"/(app-data|audio|homes|shared-files|video|photos|job-accelerator-keys)\"})",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "pool": 0,
              "volume": 1,
              "Value": 2
            },
            "renameByName": {
              "pool": "Pool",
              "volume": "Dataset",
              "Value": "Age"
            }
          }
        }
      ]
    },
