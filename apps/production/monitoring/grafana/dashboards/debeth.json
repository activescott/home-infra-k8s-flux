{
  "uid": "debeth",
  "title": "debeth / Validator",
  "tags": [
    "debeth",
    "ethereum"
  ],
  "description": "Scott's eth-docker validator host, from metrics its Alloy remote-writes with host=\"debeth\". Alerts: rule group debeth in prometheus/helmrelease.yaml; runbook: runbooks/DebethValidator.md.",
  "editable": false,
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "name": "Annotations & Alerts",
        "type": "dashboard",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Beacon sync status",
      "description": "lodestar_sync_status: 0 Stalled, 1 SyncingFinalized, 2 SyncingHead, 3 Synced. DebethBeaconNotSynced fires below 3.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 3
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Stalled",
                  "index": 0
                },
                "1": {
                  "text": "Syncing finalized",
                  "index": 1
                },
                "2": {
                  "text": "Syncing head",
                  "index": 2
                },
                "3": {
                  "text": "Synced",
                  "index": 3
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "max(lodestar_sync_status{host=\"debeth\"})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Validator client: beacon health",
      "description": "vc_beacon_health: 0 READY, 1 SYNCING, 2 ERROR. DebethValidatorBeaconUnhealthy fires above 0.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Ready",
                  "index": 0
                },
                "1": {
                  "text": "Syncing",
                  "index": 1
                },
                "2": {
                  "text": "Error",
                  "index": 2
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "max(vc_beacon_health{host=\"debeth\"})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Validators loaded",
      "description": "Validators the beacon node monitors and indices the validator client resolved. DebethValidatorNotActive fires when either is below 1.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "max(validator_monitor_validators{host=\"debeth\"})",
          "refId": "A",
          "legendFormat": "Beacon monitor"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "max(vc_indices_count{host=\"debeth\"})",
          "refId": "B",
          "legendFormat": "VC indices"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Target attestation hits, 30m",
      "description": "On-chain target votes in the last 30 minutes. DebethValidatorNotAttesting fires below 1.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "sum(increase(validator_monitor_prev_epoch_on_chain_target_attester_hit_total{host=\"debeth\"}[30m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Attestation hits and misses per hour",
      "description": "On-chain attestation outcomes from the beacon node's validator monitor, per vote type, counted over the trailing hour. DebethMissedAttestations fires above 2 target misses.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* miss"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "sum(increase(validator_monitor_prev_epoch_on_chain_source_attester_hit_total{host=\"debeth\"}[1h]))",
          "refId": "A",
          "legendFormat": "source hit"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "sum(increase(validator_monitor_prev_epoch_on_chain_target_attester_hit_total{host=\"debeth\"}[1h]))",
          "refId": "B",
          "legendFormat": "target hit"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "sum(increase(validator_monitor_prev_epoch_on_chain_head_attester_hit_total{host=\"debeth\"}[1h]))",
          "refId": "C",
          "legendFormat": "head hit"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "sum(increase(validator_monitor_prev_epoch_on_chain_source_attester_miss_total{host=\"debeth\"}[1h]))",
          "refId": "D",
          "legendFormat": "source miss"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "sum(increase(validator_monitor_prev_epoch_on_chain_target_attester_miss_total{host=\"debeth\"}[1h]))",
          "refId": "E",
          "legendFormat": "target miss"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "sum(increase(validator_monitor_prev_epoch_on_chain_head_attester_miss_total{host=\"debeth\"}[1h]))",
          "refId": "F",
          "legendFormat": "head miss"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Validator balance",
      "description": "On-chain balance at the end of the previous epoch, summed over debeth's validators. Withdrawal sweeps lower it on every cycle.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: ETH",
          "decimals": 4,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "sum(validator_monitor_prev_epoch_on_chain_balance{host=\"debeth\"}) / 1e9",
          "refId": "A",
          "legendFormat": "Balance"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Beacon head slot lag",
      "description": "Wall-clock slot minus head slot. DebethBeaconNotSynced fires above 8.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 8
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "max(beacon_clock_slot{host=\"debeth\"}) - max(beacon_head_slot{host=\"debeth\"})",
          "refId": "A",
          "legendFormat": "Slots behind"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Peers",
      "description": "Consensus (Lodestar libp2p) and execution (Besu, via ethereum-metrics-exporter) peer counts. Alerts fire below 20 and 5.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "max(libp2p_peers{host=\"debeth\"})",
          "refId": "A",
          "legendFormat": "Consensus"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "max(eth_exe_net_peer_count{host=\"debeth\"})",
          "refId": "B",
          "legendFormat": "Execution"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Execution block height",
      "description": "Besu's latest block from ethereum-metrics-exporter (left) and whether it reports syncing (right). DebethExecutionNotSynced fires when the height is flat for 5 minutes or syncing is 1.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Syncing"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "max(eth_exe_block_most_recent_number{host=\"debeth\"})",
          "refId": "A",
          "legendFormat": "Block"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "max(eth_exe_sync_is_syncing{host=\"debeth\"})",
          "refId": "B",
          "legendFormat": "Syncing"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "MEV relay status codes per hour",
      "description": "HTTP answers from each relay over the trailing hour, from Commit-Boost (cb-pbs). 555 is Commit-Boost's code for no HTTP answer (DNS, TCP or timeout); DebethMevRelayUnreachable fires on it. DebethMevRelayErrors fires above 3 other non-2xx.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "sum by (relay_id, http_status_code) (increase(cb_pbs_relay_status_code_total{host=\"debeth\"}[1h]))",
          "refId": "A",
          "legendFormat": "{{relay_id}} {{http_status_code}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "MEV relay mean latency",
      "description": "Mean request latency per relay and endpoint, from Commit-Boost (cb-pbs), which records seconds.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "sum by (relay_id, endpoint) (rate(cb_pbs_relay_latency_sum{host=\"debeth\"}[$__rate_interval])) / sum by (relay_id, endpoint) (rate(cb_pbs_relay_latency_count{host=\"debeth\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{relay_id}} {{endpoint}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Root disk used",
      "description": "Fraction of / used. The chain databases live here. DebethDiskFull warns at 90% and is critical at 95%.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.9
              },
              {
                "color": "red",
                "value": 0.95
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "1 - node_filesystem_avail_bytes{host=\"debeth\",mountpoint=\"/\"} / node_filesystem_size_bytes{host=\"debeth\",mountpoint=\"/\"}",
          "refId": "A",
          "legendFormat": "/"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "CPU used",
      "description": "Fraction of CPU time not idle, across all cores.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "1 - avg(rate(node_cpu_seconds_total{host=\"debeth\",mode=\"idle\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "CPU"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Memory used",
      "description": "1 - MemAvailable / MemTotal.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "1 - node_memory_MemAvailable_bytes{host=\"debeth\"} / node_memory_MemTotal_bytes{host=\"debeth\"}",
          "refId": "A",
          "legendFormat": "Memory"
        }
      ]
    },
    {
