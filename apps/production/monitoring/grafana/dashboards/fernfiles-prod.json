{
  "uid": "fernfiles-prod",
  "title": "Fernfiles Prod Status",
  "description": "Health of the fernfiles-prod namespace. Built after the 2026-08-16 outage, where the app crashed and restarted 3 times unnoticed and was only found when a user hit \"no available server\". The Restarts and Last termination reason panels are the ones that would have shown it.",
  "editable": true,
  "schemaVersion": 41,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "fernfiles"
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Availability",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 3
      },
      "id": 1,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "App available replicas",
      "description": "Replicas actually available in the app Deployment. Pods come and go on every rollout, so pod counts flap for benign reasons; a Deployment's available count should never be 0. Compare against desired on the Deployment availability panel below.",
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "editorMode": "code",
          "expr": "max(kube_deployment_status_replicas_available{namespace=\"fernfiles-prod\", deployment=\"app\"}) or vector(0)",
          "instant": true,
          "legendFormat": "available",
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Database",
      "description": "Postgres StatefulSet: green Up, red Down. Tenet #1 store — losing this is worse than losing the web pod. The query is wrapped in max() so it always reduces to exactly one value: a bare selector `or vector(0)` returns BOTH series, because `or` unions when the label sets differ, which is why this panel used to show a green 1 and a red 0 at the same time.",
      "id": 3,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "index": 0,
                  "text": "Down",
                  "color": "red"
                },
                "1": {
                  "index": 1,
                  "text": "Up",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "editorMode": "code",
          "expr": "max(kube_statefulset_status_replicas_ready{namespace=\"fernfiles-prod\", statefulset=\"db\"}) or vector(0)",
          "instant": true,
          "legendFormat": "database",
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "App restarts (24h)",
