    {
      "type": "timeseries",
      "title": "Deployment availability",
      "description": "Available replicas vs desired, per Deployment. Desired is the dashed line; any gap below it means replicas are missing and the site is degraded or down. Deployment-level rather than pod-level on purpose: pods churn on every rollout, so pod readiness flaps for benign reasons, while a Deployment should always have its desired count available.",
      "id": 9,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 25,
            "lineWidth": 2,
            "showPoints": "always",
            "pointSize": 5,
            "stepAfter": true,
            "spanNulls": true
          },
          "mappings": [],
          "max": 1,
          "min": 0,
          "unit": "none",
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*desired.*"
            },
            "properties": [
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              }
            ]
          }
        ]
      },
      "options": {
