{
  "uid": "fernfiles-prod",
  "title": "Fernfiles Prod Status",
  "description": "Health of the fernfiles-prod namespace. Built after the 2026-08-16 outage, where the app crashed and restarted 3 times unnoticed and was only discovered when a user got \"no available server\" from Prague. The Restarts and Last termination reason panels are the ones that would have shown it.",
  "editable": true,
  "schemaVersion": 41,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "fernfiles"
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Availability",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "App pods ready",
      "description": "Single replica by design (k8s/base/app-deployment.yaml), so 0 here means the site is down for everyone, not degraded. Tracked by issue #46 / #143.",
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "editorMode": "code",
          "expr": "count(kube_pod_status_ready{namespace=\"fernfiles-prod\", pod=~\"app-.*\", condition=\"true\"} == 1) or vector(0)",
          "instant": true,
          "legendFormat": "ready",
          "range": false,
          "refId": "A"
        }
      ]
    },
