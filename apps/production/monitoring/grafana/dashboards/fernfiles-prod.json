          "editorMode": "code",
          "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"fernfiles-prod\", container=\"app\"}[24h])) or vector(0)",
          "instant": true,
          "legendFormat": "restarts",
          "range": false,
          "refId": "A"
        }
      ]
    },
