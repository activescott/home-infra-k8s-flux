    {
      "type": "stat",
      "title": "WAN drops (1h)",
      "description": "igb0 carrier drops in the last hour. Each is a ~5-9s internet outage.",
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
