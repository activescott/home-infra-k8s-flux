        {
          "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
          "editorMode": "code",
          "expr": "sum(count_over_time({host=\"theshield\"} |= \"igb0: link state changed to DOWN\" [1h]))",
          "queryType": "instant",
          "refId": "A"
