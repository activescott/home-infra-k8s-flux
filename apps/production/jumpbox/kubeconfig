# kubectl in an ssh session, as the jumpbox ServiceAccount. tokenFile is re-read as the
# kubelet rotates the projected token.
apiVersion: v1
kind: Config
clusters:
  - name: nas1
    cluster:
      server: https://kubernetes.default.svc
      certificate-authority: /var/run/secrets/kubernetes.io/serviceaccount/ca.crt
users:
  - name: jumpbox
    user:
      tokenFile: /var/run/secrets/kubernetes.io/serviceaccount/token
contexts:
  - name: nas1
    context:
      cluster: nas1
      user: jumpbox
current-context: nas1
