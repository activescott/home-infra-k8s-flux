<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Apple configuration profile: mail, calendar and contacts for mail.activescott.com.

  A TEMPLATE. Served only from /setup/profiles/<address>/apple.mobileconfig, or
  /setup/profiles/<address>/name/<display name>/apple.mobileconfig, where nginx substitutes every
  occurrence of __EMAIL__ and __NAME__ with the values captured from the path (see
  nginx-default.conf). It is never served raw -- a request that does not match the address regex is
  redirected back to the form instead, so nobody receives a profile containing the literal
  placeholder. When the name segment is absent, __NAME__ falls back to the address.

  This is now the ONLY profile. An identity-free fallback used to sit at /setup/apple.mobileconfig
  for anyone who preferred typing their address into the device, but it could only ever carry the
  mail payload: CalDAVUsername and CardDAVUsername are documented as required rather than
  prompted, so a DAV payload without a username may fail to install rather than ask for one.
  Silently setting up two of the three services is a worse outcome than being sent back to the
  form, so it was removed.

  Still no passwords. Apple's reference marks IncomingPassword, OutgoingPassword, CalDAVPassword
  and CardDAVPassword "Encrypted profiles only", and this is served in the clear. The consequence
  is three password prompts on install -- mail, calendar, contacts -- all taking the same app
  password. OutgoingPasswordSameAsIncomingPassword collapses the two mail prompts into one but is
  scoped to its own payload; nothing spans payloads, so the DAV pair cannot be folded in. Getting
  to one prompt would mean carrying the password through the URL and into a cleartext file in
  Downloads, which is a worse trade than two extra taps.

  PayloadUUID and PayloadIdentifier are fixed, so installing a second address on the same device
  REPLACES the first rather than adding to it. Deliberate for one-mailbox-per-person. Making the
  identifier address-derived would be a one-line sub_filter, but the UUIDs cannot be generated in
  nginx, and whether iOS tolerates two profiles sharing a UUID is untested -- so the display
  strings below carry the address purely to make the installed profile identifiable.

  CalDAV and CardDAV carry no PrincipalURL on purpose. Stalwart answers /.well-known/caldav and
  /.well-known/carddav with a 307 to /dav/cal and /dav/card (verified 2026-08-28), which is the
  discovery mechanism Apple uses when the key is absent. If discovery ever breaks, the fix is to
  add CalDAVPrincipalURL /dav/cal/ and CardDAVPrincipalURL /dav/card/ here.
-->
<plist version="1.0">
<dict>
  <key>PayloadDisplayName</key>
  <string>__EMAIL__ (mail.activescott.com)</string>
  <key>PayloadDescription</key>
  <string>Mail, calendar and contacts for __EMAIL__. You will be asked for your app password three times, once per service.</string>
  <!-- Shown on its own screen before Install, so the three-prompt surprise arrives as a warning
       rather than as a bug report. Keyed by language; "default" covers every locale we serve. -->
  <key>ConsentText</key>
  <dict>
    <key>default</key>
    <string>This sets up mail, calendar and contacts for __EMAIL__ on mail.activescott.com.

You will be asked for your app password three times — once each for mail, calendar and contacts. It is the same password every time. Use the app password created at admin.mail.activescott.com, not your sign-in password.</string>
  </dict>
  <key>PayloadIdentifier</key>
  <string>com.activescott.mail.stalwart</string>
  <key>PayloadOrganization</key>
  <string>activescott</string>
  <key>PayloadType</key>
  <string>Configuration</string>
  <key>PayloadUUID</key>
  <string>92F26BF0-772D-4871-9B6F-09B2A0B6132D</string>
  <key>PayloadVersion</key>
  <integer>1</integer>
  <key>PayloadRemovalDisallowed</key>
  <false/>
  <key>PayloadContent</key>
  <array>

    <dict>
      <key>PayloadType</key>
      <string>com.apple.mail.managed</string>
      <key>PayloadIdentifier</key>
      <string>com.activescott.mail.stalwart.account</string>
      <key>PayloadUUID</key>
      <string>47C140D7-BF98-4187-BFC3-0DDC63214BA9</string>
      <key>PayloadVersion</key>
      <integer>1</integer>
      <key>PayloadDisplayName</key>
      <string>Mail</string>

      <!-- The address, not the hostname: this is the label in Settings and in Mail's mailbox
           list, and every account on this server would otherwise read identically. -->
      <key>EmailAccountDescription</key>
      <string>__EMAIL__</string>
      <key>EmailAccountType</key>
      <string>EmailTypeIMAP</string>
      <key>EmailAddress</key>
      <string>__EMAIL__</string>
      <!-- The display name on outgoing mail. Absent, iOS prompts for it at install and sends
           with no display name if skipped. Falls back to the address when the setup page's
           name field is left empty. -->
      <key>EmailAccountName</key>
      <string>__NAME__</string>

      <key>IncomingMailServerHostName</key>
      <string>mail.activescott.com</string>
      <key>IncomingMailServerPortNumber</key>
      <integer>993</integer>
      <key>IncomingMailServerUseSSL</key>
      <true/>
      <key>IncomingMailServerAuthentication</key>
      <string>EmailAuthPassword</string>
      <key>IncomingMailServerUsername</key>
      <string>__EMAIL__</string>

      <!-- 465, implicit TLS. Stalwart starts no STARTTLS listener on 587; stating the port here
           is the entire reason this profile exists. -->
      <key>OutgoingMailServerHostName</key>
      <string>mail.activescott.com</string>
      <key>OutgoingMailServerPortNumber</key>
      <integer>465</integer>
      <key>OutgoingMailServerUseSSL</key>
      <true/>
      <key>OutgoingMailServerAuthentication</key>
      <string>EmailAuthPassword</string>
      <key>OutgoingMailServerUsername</key>
      <string>__EMAIL__</string>
      <!-- One password prompt for mail instead of two. There is no equivalent for usernames,
           and none that spans the DAV payloads below. -->
      <key>OutgoingPasswordSameAsIncomingPassword</key>
      <true/>

      <key>PreventMove</key>
      <false/>
      <key>PreventAppSheet</key>
      <false/>
      <key>SMIMEEnabled</key>
      <false/>
      <!-- Defaults to false, which silently removes the Mail Drop option for this account.
           Worth turning on precisely because this server is small: a large attachment would
           otherwise be refused outright, and Mail Drop routes it through iCloud instead.
           Requires the device to be signed into iCloud; harmless when it is not. -->
      <key>allowMailDrop</key>
      <true/>
    </dict>

    <dict>
      <key>PayloadType</key>
      <string>com.apple.caldav.account</string>
      <key>PayloadIdentifier</key>
      <string>com.activescott.mail.stalwart.caldav</string>
      <key>PayloadUUID</key>
      <string>D4D05417-34FB-47E3-BB62-7D3A3CB44C4D</string>
      <key>PayloadVersion</key>
      <integer>1</integer>
      <key>PayloadDisplayName</key>
      <string>Calendar</string>

      <key>CalDAVAccountDescription</key>
      <string>__EMAIL__</string>
      <key>CalDAVHostName</key>
      <string>mail.activescott.com</string>
      <key>CalDAVPort</key>
      <integer>443</integer>
      <key>CalDAVUseSSL</key>
      <true/>
      <key>CalDAVUsername</key>
      <string>__EMAIL__</string>
    </dict>

    <dict>
      <key>PayloadType</key>
      <string>com.apple.carddav.account</string>
      <key>PayloadIdentifier</key>
      <string>com.activescott.mail.stalwart.carddav</string>
      <key>PayloadUUID</key>
      <string>2C63DAA7-EAEF-4162-AED2-FACD0936F397</string>
      <key>PayloadVersion</key>
      <integer>1</integer>
      <key>PayloadDisplayName</key>
      <string>Contacts</string>

      <key>CardDAVAccountDescription</key>
      <string>__EMAIL__</string>
      <key>CardDAVHostName</key>
      <string>mail.activescott.com</string>
      <key>CardDAVPort</key>
      <integer>443</integer>
      <key>CardDAVUseSSL</key>
      <true/>
      <key>CardDAVUsername</key>
      <string>__EMAIL__</string>
    </dict>

  </array>
</dict>
</plist>
