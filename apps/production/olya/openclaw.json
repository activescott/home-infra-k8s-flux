// OpenClaw gateway configuration. JSON5: comments and trailing commas are allowed.
//
// THIS FILE IS THE SOURCE OF TRUTH. The seed-config initContainer copies it over
// $OPENCLAW_STATE_DIR/openclaw.json on EVERY pod start, unconditionally. That inverts OpenClaw's
// own documented k8s pattern, which seeds only when the file is missing and then treats the
// persisted copy as authoritative. The consequence is deliberate: anything changed through the
// Control UI, `openclaw config set`, or `doctor --fix` is lost on the next restart. Change it
// here, in git, or it does not stick.
//
// OpenClaw validates strictly and REFUSES TO START on an unknown key, a wrong type, or an
// invalid value. Validate before committing:
//   docker run --rm ghcr.io/openclaw/openclaw:slim openclaw config schema > schema.json
// Every key below was checked against the schema of 2026.9.4.
//
// Runtime state that is NOT here and cannot be: model auth profiles, the managed `gh` OAuth
// profile, exec approval grants, channel pairings, and all cron jobs. Those live in SQLite on
// the PV and are re-established by hand after a volume loss. See the runbook.
{
  gateway: {
    // REQUIRED, even though `openclaw config validate` passes without it. The gateway refuses
    // to start on a config that has no gateway.mode, treating it as clobbered:
    //   "Gateway start blocked: existing config is missing gateway.mode."
    // Validation is therefore necessary but not sufficient -- it does not catch this.
    // "local" runs channels and the agent runtime in this pod; "remote" is for a split
    // topology we do not have.
    mode: "local",
    // Must be "lan" rather than the default loopback, or Traefik cannot reach the pod.
    bind: "lan",
    port: 18789,
    // Traefik terminates TLS and forwards, so every request arrives with client identity in
    // headers rather than in the socket. Without this the gateway refuses to attribute the
    // caller at all and answers "proxy_attribution_required" -- the Control UI just renders
    // that JSON error instead of loading.
    //
    // The cluster pod CIDR, not a single address: Traefik's pod IP changes on every restart.
    // That is wider than it looks only in theory -- the NetworkPolicy admits port 18789 solely
    // from Traefik pods in kube-system, so nothing else can open a connection here to present
    // forged headers in the first place. The two settings are load-bearing together; narrowing
    // that policy without revisiting this list would be the thing to think twice about.
    trustedProxies: ["172.16.0.0/16"],
    auth: {
      // Second of two independent auth layers; the Traefik basicAuth middleware in
      // olya-ingress.yaml is the first. Both are required. Do not set this to "none".
      mode: "token",
      token: "${OPENCLAW_GATEWAY_TOKEN}",
    },
    controlUi: {
      enabled: true,
      // Required for a non-loopback Control UI. The gateway auto-seeds only
      // http://localhost:18789 and http://127.0.0.1:18789 for bind=lan, and the browser
      // origin here is the ingress hostname -- so without this the page loads and its
      // WebSocket is rejected, which looks like a broken UI rather than a config gap.
      // Full origins only, and never ["*"].
      allowedOrigins: ["https://olya.activescott.com"],
    },
  },

  logging: {
    level: "info",
    // Alloy tails every pod's stdout and promotes `level` when the JSON is pino-shaped. Leaving
    // logging.file unset keeps stdout as the only sink, so there is no log file growing on the PV.
    consoleStyle: "json",
    redactPatterns: [
      "\\b(gh[pousr]_[A-Za-z0-9]{20,})\\b",
      "\\b(github_pat_[A-Za-z0-9_]{20,})\\b",
      "\\b(sk-ant-[A-Za-z0-9-]{20,})\\b",
      "\\b([0-9]{8,10}:[A-Za-z0-9_-]{30,})\\b",
    ],
  },

  diagnostics: {
    // Required for the Prometheus plugin to expose /api/diagnostics/prometheus.
    enabled: true,
  },

  plugins: {
    // acpx is installed as a managed plugin by the install-plugins initContainer, which
    // creates the trust record required for openKeyedStore (ACP session state). The managed
    // install persists on the PV at $OPENCLAW_STATE_DIR. Do not add acpx back to load.paths:
    // loading both the managed copy and a baked-in copy causes an install-path-mismatch.
    //
    // diagnostics-prometheus remains baked into the image and loaded by path because it does
    // not need keyed-store trust.
    load: {
      paths: [
        "/opt/olya/plugins/diagnostics-prometheus/node_modules/@openclaw/diagnostics-prometheus",
      ],
    },
    entries: {
      "diagnostics-prometheus": { enabled: true },
      acpx: { enabled: true },
    },
  },

  agents: {
    // Explicit roster. With ownership "explicit", an unmatched binding fails closed rather than
    // silently falling through to some default agent.
    ownership: "explicit",
    defaults: {
      workspace: "/state/workspace",
      model: {
        primary: "anthropic/claude-opus-4-6",
      },
      // Route all Anthropic models through the installed `claude` executable rather than
      // the Anthropic API, so turns draw on Claude Max subscription instead of per-token
      // API billing. This includes utility models (session titles, observer headlines)
      // which default to claude-haiku-4-5.
      //
      // The credential is NOT here and cannot be. `claude auth login` was run once inside the
      // pod and its login lives under $HOME/.claude on the PV; OpenClaw only records a route
      // marker and never reads, refreshes or forwards the token. That makes this another
      // redo-by-hand item after a volume loss -- see the runbook.
      models: {
        "anthropic/*": {
          agentRuntime: { id: "claude-cli" },
        },
      },
      // All optional bootstrap files are managed in git. Without this, OpenClaw overwrites
      // them with blank templates on every gateway start.
      skipOptionalBootstrapFiles: ["SOUL.md", "IDENTITY.md", "USER.md"],
      // With an explicit multi-agent roster there is no ambient agent, so heartbeats stay
      // disabled until one is named here. Required, not optional.
      heartbeat: {
        agentId: "olya",
      },
      systemAgent: {
        agentId: "olya",
      },
      // Pacific time for message envelopes, scheduled events, and the system prompt date context.
      userTimezone: "America/Los_Angeles",
    },
    entries: {
      // The controller. Everything real is delegated from here.
      olya: {
        name: "Olya",
        workspace: "/state/workspace",
        subagents: {
          delegationMode: "prefer",
          allowAgents: ["opencode", "claude"],
        },
      },

      // Coding harnesses, reached over ACP. Each is a separate agent entry so it can carry its
      // own model and be named explicitly in sessions_spawn.
      "opencode": {
        name: "opencode",
        runtime: {
          type: "acp",
          acp: { agent: "opencode" },
        },
      },
      "claude": {
        name: "claude",
        runtime: {
          type: "acp",
          acp: { agent: "claude" },
        },
      },
    },
  },

  acp: {
    enabled: true,
    backend: "acpx",
    defaultAgent: "opencode",
    allowedAgents: ["opencode", "claude"],
  },

  // Telegram has to be told which agent owns the conversation. With more than one agent
  // configured it refuses to start the channel rather than guessing:
  //   "Multiple agents are configured, but telegram account default routing has no explicit
  //    owner. Add a channel-wide binding for telegram:default or configure a sole agent."
  // She is the controller and the coder agents are only ever reached through sessions_spawn,
  // so everything inbound routes to her.
  bindings: [
    {
      type: "route",
      agentId: "olya",
      comment: "All Telegram traffic belongs to the controller.",
      match: { channel: "telegram", accountId: "default" },
    },
  ],

  channels: {
    telegram: {
      enabled: true,
      // Bot API 10.3 rich formatting: tables, details, checklists, collapsible sections.
      richMessages: true,
      // MUST resolve to a regular file, which is why the StatefulSet mounts this with subPath.
      // A normal Kubernetes Secret volume is a symlink chain (token -> ..data/token), and
      // OpenClaw's secret loader does not follow it -- it reports "Secret owner
      // account:telegram:default is configured but unavailable (credential file is
      // unavailable)", which reads like a missing or unreadable file rather than a symlink it
      // declined to follow. Verified both layouts against this image.
      tokenFile: "/etc/olya-telegram/token",
      // Inbound allowlist. A Telegram bot is publicly addressable, so without this anyone who
      // finds t.me/olyapopbot could talk to her. "pairing" would instead bind to whoever
      // messages first, which is a race not worth running on a bot that can open PRs.
      dmPolicy: "allowlist",
      allowFrom: ["${TELEGRAM_ALLOW_FROM}"],
      groupPolicy: "disabled",
    },
  },

  skills: {
    load: {
      // <workspace>/skills is discovered automatically and is the highest-precedence root, so
      // nothing needs listing here. shared/ is deliberately NOT added: it holds prose rules read
      // by the coding harnesses, not SKILL.md directories, and pointing a skill root at it would
      // scan a directory that can never contain a skill.
      watch: true,
    },
  },
}
