# !! DO NOT TYPE A REAL VALUE INTO THIS FILE. It is committed and this repository is
# !! PUBLIC. The placeholder below is deliberately not blank, so that a value left
# !! unreplaced fails loudly at authentication instead of silently becoming an empty
# !! credential. Never edit this file in place.
#
# TEMPLATE, committed. The real secret is .env.secret.google-workspace.encrypted, and that
# ciphertext is the only copy. Create it once from this template (`new` refuses if it
# already exists), from the repo root:
#
#   ./scripts/onepassword-secrets.mts new apps/production/olya/.env.secret.google-workspace \
#     --from apps/production/olya/env.secret.google-workspace.example
#
# Change it afterwards with `./scripts/onepassword-secrets.mts edit` on the same path.
#
# Run these YOURSELF rather than asking the agent to. The agent must never read the
# decrypted values: on 2026-08-29 two credentials were burned because the real file was in
# the agent's read-set and the harness reported the change including the secret line, even
# though the edit happened outside the agent's tools.

# Google Workspace MCP credentials for activescott/google-workspace-mcp
# (feat/injected-credentials branch).
#
# These enable Olya to read/send email and manage calendar via the MCP server.
# The credential JSON file and these env vars are mounted into the pod separately;
# see the kustomization.yaml secretGenerator and the statefulset volume mounts.

# OAuth Client ID from the GCP "Desktop app" credential.
# See scripts/setup-google-workspace-gcp/README.md for setup instructions.
google_workspace_client_id=<REPLACE-ME-with-oauth-client-id>

# OAuth Client Secret from the same GCP credential.
# Enables direct Google token refresh instead of the Gemini CLI cloud function.
google_workspace_client_secret=<REPLACE-ME-with-oauth-client-secret>

# The full credential JSON from the OAuth consent flow, as a single line.
# Run scripts/setup-google-workspace-gcp/get-tokens.mjs (see its README.md) and
# complete the consent in your browser; it writes the JSON into the encrypted file.
#
# Format: {"access_token":"ya29...","refresh_token":"1//...","token_type":"Bearer","expiry_date":1234567890000,"scope":"..."}
#
# The statefulset projects this into a file at /etc/olya-google-workspace/credentials.json
# via a volume mount, and sets WORKSPACE_CREDENTIALS_PATH to that path.
google_workspace_credentials_json=<REPLACE-ME-with-credential-json-single-line>
