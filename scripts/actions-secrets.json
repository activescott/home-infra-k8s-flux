{
  "secrets": {
    "ZOT_CI_PASSWORD": {
      "source": {
        "sops": "apps/production/zot/.env.secret.zot-passwords.encrypted",
        "key": "CI_PASSWORD"
      },
      "apps": ["actions", "dependabot"],
      "repos": [
        "activescott/fernfiles",
        "activescott/ramblefeed"
      ]
    },
    "ZOT_MIRROR_PASSWORD": {
      "source": {
        "sops": "apps/production/zot/.env.secret.zot-passwords.encrypted",
        "key": "MIRROR_PASSWORD"
      },
      "apps": ["actions", "dependabot"],
      "repos": [
        "activescott/browser-chaperone",
        "activescott/fernfiles",
        "activescott/gpu-poet",
        "activescott/job-accelerator",
        "activescott/ramblefeed",
        "activescott/tinkerbell"
      ]
    }
  }
}
