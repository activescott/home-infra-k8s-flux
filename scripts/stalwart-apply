#!/usr/bin/env bash
# Run the declarative Stalwart configuration plan.
#
#   ./scripts/stalwart-apply plan            # dry run, sends nothing to the server
#   ./scripts/stalwart-apply apply           # apply the plan
#   ./scripts/stalwart-apply bootstrap       # FRESH SERVER ONLY: create accounts
#   ./scripts/stalwart-apply apply-recovery  # FRESH SERVER ONLY: apply config pre-API-key
#   ./scripts/stalwart-apply snapshot <Object> [<Object>...]
#   ./scripts/stalwart-apply query <Object> [fields]
#
# The plan lives at apps/production/email-stalwart/stalwart-config/plan.ndjson and is
# applied by stalwart-cli against the in-cluster admin service. Design and rationale:
# docs/specs/stalwart-config-as-code/plan.md
#
# `plan` and `apply` materialise a Job from a suspended CronJob that Flux keeps current, so
# they always run whatever plan is deployed — which is the committed plan, not the working
# tree. Commit and let Flux reconcile before applying.
set -euo pipefail

context=nas
namespace=email-stalwart
# Which Secret supplies credentials to the ad-hoc read commands. Defaults to the API key.
# Override with the recovery admin when no API key exists — immediately after a rebuild, for
# example, since an API key is a credential on an account and the store starts empty:
#   STALWART_APPLY_SECRET=stalwart-bootstrap-creds ./scripts/stalwart-apply query Account
secret=${STALWART_APPLY_SECRET:-stalwart-cli-creds}
image=ghcr.io/stalwartlabs/cli:1.0.12@sha256:fe199affac1d120a8c200ef39ae629765a2976270e0453575c1caf906ee15b52
url=http://stalwart-admin.email-stalwart.svc.cluster.local:8080

usage() {
  sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'
  exit "${1:-1}"
}

run_job() {
  local cronjob=$1 job
  # Job names must be unique; the suffix is a timestamp rather than a random string so a
  # failed run is identifiable in `kubectl get jobs` by when it happened.
  job="${cronjob}-$(date +%Y%m%d-%H%M%S)"

  echo "==> creating job/${job} from cronjob/${cronjob}"
  kubectl --context "$context" -n "$namespace" create job "$job" --from="cronjob/${cronjob}"

  # Wait for either outcome, so a failure surfaces here instead of hanging until timeout.
  echo "==> waiting"
  if ! kubectl --context "$context" -n "$namespace" wait --for=condition=complete \
    --timeout=180s "job/${job}" 2>/dev/null; then
    kubectl --context "$context" -n "$namespace" logs "job/${job}" || true
    echo "!! job/${job} did not complete. Left in place for inspection:" >&2
    echo "   kubectl --context ${context} -n ${namespace} describe job/${job}" >&2
    exit 1
  fi

  kubectl --context "$context" -n "$namespace" logs "job/${job}"
  kubectl --context "$context" -n "$namespace" delete "job/${job}" >/dev/null
  echo "==> done"
}

# Read-only ad-hoc commands run as a one-off pod rather than a CronJob: the subcommand and
# its arguments change every time, and `kubectl create job --from` cannot override args.
# envFrom pulls the token straight from the Secret, so it is never passed on a command line
# where it would land in shell history or a process listing.
run_pod() {
  local name="stalwart-cli-$1-$$" overrides
  shift
  # Build the whole override document with python rather than string-concatenating it.
  # An earlier version used printf '"%s"' per argument, which silently corrupted any
  # argument containing a quote — e.g. --field 'permissions={"@type":"Replace"}' arrived
  # as broken JSON and the server rejected it as "Invalid JSON Patch", which looks like a
  # schema error rather than a quoting bug.
  overrides=$(NAME="$name" IMAGE="$image" URL="$url" SECRET="$secret" python3 -c '
import json, os, sys
print(json.dumps({"spec": {"containers": [{
    "name": os.environ["NAME"],
    "image": os.environ["IMAGE"],
    "args": sys.argv[1:],
    "env": [{"name": "STALWART_URL", "value": os.environ["URL"]}],
    "envFrom": [{"secretRef": {"name": os.environ["SECRET"]}}],
}]}}))
' "$@")

  kubectl --context "$context" -n "$namespace" run "$name" \
    --rm --attach --restart=Never --quiet \
    --image="$image" --overrides="$overrides"
}

case "${1:-}" in
plan) run_job stalwart-config-plan ;;
apply) run_job stalwart-config-apply ;;
apply-recovery)
  # Applies the same plan as `apply`, but as the recovery admin. Only for the window on a
  # freshly rebuilt server between an empty store and a human minting an API key.
  run_job stalwart-config-apply-recovery
  ;;
bootstrap)
  # FRESH SERVERS ONLY. Creates the admin and automation accounts, authenticating as the
  # recovery admin because no API key can exist yet. Running it against a populated server
  # is not destructive — the accounts upsert by name — but it is never the right command.
  run_job stalwart-config-bootstrap
  ;;
snapshot)
  shift
  [ $# -ge 1 ] || usage
  # Emits exactly what `apply` consumes, with #-references wired. Keep only the objects
  # that differ from Stalwart's defaults — see stalwart-config/README.md.
  run_pod snap snapshot "$@"
  ;;
query)
  shift
  [ $# -ge 1 ] || usage
  run_pod query query "$@"
  ;;
cli)
  # Escape hatch: any stalwart-cli subcommand, e.g.
  #   ./scripts/stalwart-apply cli describe MtaDeliverySchedule
  # Read-only ones are safe; note create/update/delete bypass the plan and so bypass
  # review. Prefer editing plan.ndjson.
  shift
  [ $# -ge 1 ] || usage
  run_pod cli "$@"
  ;;
*) usage 0 ;;
esac
