{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],

  // Supply-chain guardrail: never propose a release younger than 7 days
  // (compromised releases are usually detected and yanked within days).
  minimumReleaseAge: "7 days",

  // Flux and kubernetes managers have no way to know which YAML files are
  // manifests, so scope them to the manifest trees explicitly.
  flux: {
    managerFilePatterns: [
      "apps/**/*.{yaml,yml}",
      "infrastructure/**/*.{yaml,yml}",
      "clusters/**/*.{yaml,yml}",
    ],
  },
  kubernetes: {
    managerFilePatterns: [
      "apps/**/*.{yaml,yml}",
      "infrastructure/**/*.{yaml,yml}",
      "clusters/**/*.{yaml,yml}",
    ],
  },

  // Authenticated Docker Hub lookups. Anonymous digest lookups hit Docker
  // Hub's rate limit ("No docker auth found"), which broke the digest-pin
  // branch. The token lives in the Mend portal (repo Settings > Credentials,
  // secret DOCKER_HUB_TOKEN) — never in this repo.
  hostRules: [
    {
      matchHost: "docker.io",
      username: "activescott",
      password: "{{ secrets.DOCKER_HUB_TOKEN }}",
    },
  ],

  packageRules: [
    {
      // Supply-chain guardrail: pin container images by digest (tag stays
      // visible: tag@sha256:...); a re-pointed tag then shows up as a
      // reviewable git diff. Docker datasource only — a global pinDigests
      // also tried to digest-pin the cvat GitRepository's git tag, which the
      // flux manager cannot write, and that aborted the whole grouped
      // pin-dependencies branch (Mend job be5c8c82, 2026-09-03).
      description: "Digest-pin container images",
      matchDatasources: ["docker"],
      pinDigests: true,
    },
    {
      // Kustomize placeholder image names in apps/base (real images are
      // patched in per app). Nothing to look up; lookups 401/403 and emit
      // "No docker auth found" warnings on every run.
      description: "Skip placeholder images",
      matchDatasources: ["docker"],
      matchPackageNames: ["/placeholder/", "/-image(-|$)/"],
      enabled: false,
    },
    {
      // Flux image-update automation owns these images (see the
      // apps/production/*/image-scanning*/ kustomizations). Exactly one bot
      // per image: Renovate must not manage them or the two bots fight over
      // the tag. When adding or removing a Flux image automation, update
      // this list — see AGENTS.md "Renovate vs Flux image automation".
      description: "Images owned by Flux image-update automation",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "ghcr.io/activescott/fernfiles/app",
        "ghcr.io/activescott/fernfiles/worker",
        "ghcr.io/activescott/gpu-poet-data/collector",
        "ghcr.io/activescott/amazon-searcher",
        "ghcr.io/activescott/gpu-agent/app",
        "ghcr.io/activescott/gpu-agent/indexnow-notifier",
        "ghcr.io/activescott/ramblefeed/app",
        "ghcr.io/activescott/www",
        "ghcr.io/activescott/tinkerbell/app",
        "ghcr.io/activescott/tinkerbell/mcp-gateway",
        "ghcr.io/tayle-co/tayle/app",
        "ghcr.io/tayle-co/tayle/worker",
        "ghcr.io/actions/gha-runner-scale-set-controller",
        "ghcr.io/actions/actions-runner",
      ],
      enabled: false,
    },
  ],
}
